# File mau moi truong ProxyManager
# Copy file nay thanh .env khi chay local, hoac copy thanh
# /opt/proxymanager/.env khi chay production bang systemd.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_mysql_password
DB_NAME=proxymanager

# Dinh danh server public
# SERVER_IP duoc agent va cau hinh FRP su dung.
# PUBLIC_IP la tuy chon, dung de kiem tra DNS domain. De trong thi se dung SERVER_IP.
SERVER_IP=203.0.113.10
PUBLIC_IP=
PUBLIC_URL=https://proxy.example.com

# Cong cua ProxyManager
DASHBOARD_PORT=8000
GRPC_PORT=50051

# Xac thuc agent
# Day la token runtime gRPC duoc gan vao install script sinh tu dashboard.
# Hay giu bi mat va rotate neu token bi lo.
AGENT_AUTH_TOKEN=change_me_agent_runtime_token

# Secret ky JWT cho phien dang nhap dashboard
JWT_SECRET=change_me_long_random_jwt_secret

# Cau hinh FRPS / tunnel
FRPS_BIND_PORT=7001
FRPS_VHOST_HTTP_PORT=18081
FRPS_DASHBOARD_PORT=7501
FRPS_TOKEN=change_me_frps_token
FRPS_CONFIG=configs/frps.yaml
FRPS_SERVICE=proxymanager-frps

# Nginx va Let's Encrypt
NGINX_PROXY_CONF_DIR=/etc/nginx/proxymanager.d
CERTBOT_EMAIL=admin@example.com

# Cau hinh build-time cho dashboard
# Vite doc bien nay khi build dashboard/.
# Neu build frontend rieng, co the dat cung gia tri trong dashboard/.env.local.
VITE_WILDCARD_DOMAIN=v1.example.com
